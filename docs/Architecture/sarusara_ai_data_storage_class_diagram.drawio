que]&lt;br&gt;status : EstimateStatus&lt;br&gt;computedAt : DateTime&lt;br&gt;ruleId / ruleVersion : String&lt;br&gt;sourceUri : String&lt;br&gt;assumptions / notices : JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#a98537;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="735" y="760" width="300" height="180" as="geometry" /></mxCell><mxCell id="lineitem" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FertilizerLineItem&lt;/b&gt;&lt;hr&gt;lineItemId : UUID [PK]&lt;br&gt;estimateId : UUID [FK]&lt;br&gt;productName : String&lt;br&gt;quantity : Decimal&lt;br&gt;unit : String&lt;br&gt;applicationStage? : String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#a98537;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="300" height="180" as="geometry" /></mxCell><mxCell id="rulesnapshot" value="&amp;lt;&amp;lt;value object&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;AgronomyRuleSnapshot&lt;/b&gt;&lt;hr&gt;ruleId : String&lt;br&gt;version / effectiveDate : String&lt;br&gt;issuingAuthority : String&lt;br&gt;sourceUri : String&lt;br&gt;conditions : JSON&lt;br&gt;recommendation : JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#a98537;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1425" y="760" width="320" height="180" as="geometry" /></mxCell><mxCell id="reportimage" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;ReportMetadata&lt;/b&gt;&lt;hr&gt;reportId : UUID [FK]&lt;br&gt;diagnosisSummary : String&lt;br&gt;userNotes? : String&lt;br&gt;createdAt : DateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#697b8c;strokeWidth=1.5;fontColor=#172b4d;fontSize=12;align=left;verticalAlign=middle;spacing=8;"