<mxfile host="app.diagrams.net" modified="2026-10-23T10:50:20Z" agent="Codex" version="24.7.17" type="device"><diagram id="storage-classes" name="Data Storage UML Classes"><mxGraphModel dx="2050" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p_app" value="APPLICATION SERVICES AND REPOSITORIES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=12;spacingLeft=14;fillColor=#f7f9fc;strokeColor=#526477;strokeWidth=1.5;fontColor=#172b4d;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="65" width="2000" height="270" as="geometry" /></mxCell><mxCell id="p_entities" value="PERSISTED DOMAIN RECORDS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=12;spacingLeft=14;fillColor=#f8fbff;strokeColor=#47749b;strokeWidth=1.5;fontColor=#172b4d;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="365" width="2000" height="690" as="geometry" /></mxCell><mxCell id="p_storage" value="PERSISTENCE ADAPTERS AND FILE STORAGE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=12;spacingLeft=14;fillColor=#f6faf7;strokeColor=#42816c;strokeWidth=1.5;fontColor=#172b4d;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="1080" width="2000" height="285" as="geometry" /></mxCell><mxCell id="title" value="Sarusara AI — Data Storage UML Class Diagram" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#172b4d;fontSize=24;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="12" width="1700" height="40" as="geometry" /></mxCell><mxCell id="registration" value="&amp;lt;&amp;lt;service&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FarmerRegistrationService&lt;/b&gt;&lt;hr&gt;+ register(profile, credentials)&lt;br&gt;+ validateRegistration()&lt;br&gt;+ hashPassword()&lt;br&gt;+ createAccountAndProfile()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#4a73a8;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="300" height="155" as="geometry" /></mxCell><mxCell id="authservice" value="&amp;lt;&amp;lt;service&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;AuthenticationService&lt;/b&gt;&lt;hr&gt;+ signIn(loginId, password)&lt;br&gt;+ verifyPasswordHash()&lt;br&gt;+ createSession()&lt;br&gt;+ signOut(sessionId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#4a73a8;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="300" height="155" as="geometry" /></mxCell><mxCell id="reportservice" value="&amp;lt;&amp;lt;service&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;DiagnosisReportService&lt;/b&gt;&lt;hr&gt;+ saveReport(report)&lt;br&gt;+ getReport(reportId, accountId)&lt;br&gt;+ listReports(accountId)&lt;br&gt;+ deleteReport(reportId, accountId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#4a73a8;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="745" y="130" width="300" height="155" as="geometry" /></mxCell><mxCell id="accountrepo" value="&amp;lt;&amp;lt;repository&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FarmerAccountRepository&lt;/b&gt;&lt;hr&gt;+ findByLoginId()&lt;br&gt;+ insert(account, profile)&lt;br&gt;+ updateProfile()&lt;br&gt;+ deactivateAccount()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6481aa;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1"