At / updatedAt : DateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#697b8c;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="300" height="190" as="geometry" /></mxCell><mxCell id="session" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;AuthSession&lt;/b&gt;&lt;hr&gt;sessionId : UUID [PK]&lt;br&gt;accountId : UUID [FK]&lt;br&gt;refreshTokenHash : String&lt;br&gt;issuedAt / expiresAt : DateTime&lt;br&gt;revokedAt? : DateTime&lt;br&gt;deviceLabel? : String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#697b8c;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="735" y="430" width="300" height="190" as="geometry" /></mxCell><mxCell id="report" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;DiagnosisReport&lt;/b&gt;&lt;hr&gt;reportId : UUID [PK]&lt;br&gt;accountId : UUID [FK]&lt;br&gt;createdAt : DateTime&lt;br&gt;reportStatus : ReportStatus&lt;br&gt;appVersion : String&lt;br&gt;modelBundleVersion : String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#697b8c;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="430" width="300" height="190" as="geometry" /></mxCell><mxCell id="fieldsnapshot" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FieldSnapshot&lt;/b&gt;&lt;hr&gt;fieldSnapshotId : UUID [PK]&lt;br&gt;reportId : UUID [FK, unique]&lt;br&gt;area : Decimal&lt;br&gt;areaUnit : String&lt;br&gt;agroZone / gnDivision? : String&lt;br&gt;waterRegime / growthStage? : String&lt;br&gt;soilTest / leafColourIndex? : Decimal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#697b8c;strokeWidth=1.5;fontColor=#172b4d;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" p